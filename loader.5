    library:apply_theme(cg, "contrast", "Color")

    local ScrollingFrame = library:create("ScrollingFrame", {
        Parent = contrast, Name = "", ScrollBarImageColor3 = themes.preset.accent, Active = true,
        MidImage = "rbxassetid://103468666327206", TopImage = "rbxassetid://103468666327206",
        BottomImage = "rbxassetid://103468666327206", AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 2, BackgroundTransparency = 1, Size = dim2(1, 0, 1, 0),
        BackgroundColor3 = rgb(255, 255, 255), BorderColor3 = rgb(0, 0, 0),
        BorderSizePixel = 0, CanvasSize = dim2(0, 0, 0, 0), ClipsDescendants = true,
    })
    library:apply_theme(ScrollingFrame, "accent", "ScrollBarImageColor3")
    library:create("UIPadding", {
        Parent = ScrollingFrame, Name = "", PaddingTop = dim(0, 4), PaddingBottom = dim(0, 4),
        PaddingRight = dim(0, 6), PaddingLeft = dim(0, 4),
    })
    library:create("UIListLayout", {
        Parent = ScrollingFrame, Name = "", Padding = dim(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
    })

    function cfg.create_player(player)
        local pname = tostring(player)
        if library.playerlist_data[pname] then return library.playerlist_data[pname] end
        local path = {}
        library.playerlist_data[pname] = path

        local TextButton = library:create("TextButton", {
            Parent = ScrollingFrame, Name = "", FontFace = library.font, TextColor3 = themes.preset.text,
            BorderColor3 = rgb(0, 0, 0), Text = "", BackgroundTransparency = 1,
            Size = dim2(1, 0, 0, 14), BorderSizePixel = 0, AutoButtonColor = false,
            TextSize = 12, BackgroundColor3 = rgb(255, 255, 255), ClipsDescendants = true,
        })

        local player_name = library:create("TextLabel", {
            Parent = TextButton, FontFace = library.font, TextColor3 = themes.preset.accent,
            BorderColor3 = rgb(0, 0, 0), Text = pname, BorderSizePixel = 0, BackgroundTransparency = 1,
            Position = dim2(0, 2, 0, 0), Size = dim2(0.55, -4, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
            TextSize = 12, BackgroundColor3 = rgb(255, 255, 255),
        })

        local priority_text = library:create("TextLabel", {
            Parent = TextButton, Name = "", FontFace = library.font,
            TextColor3 = pname ~= lp.Name and themes.preset.text or rgb(0, 0, 255),
            BorderColor3 = rgb(0, 0, 0), Text = pname ~= lp.Name and "Neutral" or "LocalPlayer",
            BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, BorderSizePixel = 0,
            Position = dim2(0.55, 6, 0, 0), Size = dim2(0.45, -10, 1, 0),
            TextSize = 12, BackgroundColor3 = rgb(255, 255, 255),
        })
        local sepline = library:create("Frame", {
            Parent = TextButton, Name = "", Position = dim2(0.55, 0, 0, 1),
            BorderColor3 = rgb(0, 0, 0), Size = dim2(0, 1, 1, -2), BorderSizePixel = 0,
            BackgroundColor3 = themes.preset.outline,
        })
        library:apply_theme(sepline, "outline", "BackgroundColor3")

        local line = library:create("Frame", {
            Parent = ScrollingFrame, Name = "", BorderColor3 = rgb(0, 0, 0),
            Size = dim2(1, 0, 0, 1), BorderSizePixel = 0, BackgroundColor3 = themes.preset.outline,
        })
        library:apply_theme(line, "outline", "BackgroundColor3")

        path.instance = TextButton
        path.line = line
        path.priority = "Neutral"
        path.priority_text = priority_text

        TextButton.MouseButton1Click:Connect(function()
            if pname == lp.Name then return end
            if selected_button then
                selected_button.TextColor3 = themes.preset.accent
                selected_button = nil
            end
            selected_button = player_name
            player_name.TextColor3 = rgb(255, 255, 255)

            library.selected_player = pname
            local setter = library.config_flags["PLAYERLIST_DROPDOWN"]
            if setter then setter(path.priority) end

            local plr = players:FindFirstChild(pname)
            if cfg.labels.name and plr then
                cfg.labels.name.set("User: " .. plr.Name)
                cfg.labels.display.set("DisplayName: " .. plr.DisplayName)
                cfg.labels.uid.set("User Id: " .. plr.UserId)
            end
        end)

        return path
    end

    function cfg.search(text)
        local q = string.lower(text or "")
        for name, path in next, library.playerlist_data do
            local vis = q == "" or string.find(string.lower(name), q, 1, true) ~= nil
            path.instance.Visible = vis
            path.line.Visible = vis
        end
    end

    function cfg.remove_player(player)
        local pname = tostring(player)
        local path = library.playerlist_data[pname]
        if not path then return end
        path.instance:Destroy()
        path.line:Destroy()
        library.playerlist_data[pname] = nil
        if library.selected_player == pname then library.selected_player = nil end
    end

    function library.prioritize(text)
        if not library.selected_player then return end
        local path = library.playerlist_data[library.selected_player]
        if not path then return end
        path.priority_text.Text = text
        path.priority_text.TextColor3 = patterns[text] or themes.preset.text
        path.priority = text
    end

    function library.get_priority(player)
        local path = library.playerlist_data[tostring(player)]
        if path then return path.priority end
    end

    library:connection(players.PlayerAdded, cfg.create_player)
    library:connection(players.PlayerRemoving, cfg.remove_player)
    for _, player in next, players:GetPlayers() do cfg.create_player(player) end

    self:textbox({name = "Search", callback = function(txt) cfg.search(txt) end})
    cfg.labels.name = self:label({name = "Name: ??", full = true})
    cfg.labels.display = self:label({name = "Display Name: ??", full = true})
    cfg.labels.uid = self:label({name = "User Id: ??", full = true})

    return setmetatable(cfg, library)
end

