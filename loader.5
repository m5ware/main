            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, BackgroundColor3 = rgb(255, 255, 255),
        })

        local function refresh(fps, ping)
            local acc = themes.preset.pink:ToHex()
            local sep = '<font color="#6b6870">|</font>'
            text.Text = string.format(
                '<font color="#%s">m5ware</font> %s %s %s %s <font color="#%s">%s</font> %s <font color="#%s">%d</font> fps %s <font color="#%s">%d</font> ms',
                acc, sep, lp.Name, sep, os.date("%d.%m.%Y"), acc, os.date("%H:%M:%S"), sep, acc, fps, sep, acc, ping
            )
        end
        refresh(60, 0)

        local frames, t0 = 0, os.clock()
        local cur_fps, cur_ping = 60, 0
        library:connection(run.RenderStepped, function() frames += 1 end)
        task.spawn(function()
            while outline.Parent do
                task.wait(0.25)
                local now = os.clock()
                if now - t0 >= 0.5 then
                    cur_fps = floor(frames / max(now - t0, 0.001) + 0.5)
                    frames, t0 = 0, now
                    local ok, val = pcall(function() return stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
                    cur_ping = ok and floor(val + 0.5) or 0
                end
                refresh(cur_fps, cur_ping)
            end
        end)

        local dragging, drag_start, start_pos = false, nil, nil
        outline.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging, drag_start, start_pos = true, input.Position, outline.Position
            end
        end)
        outline.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        library:connection(uis.InputChanged, function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local cam = ws.CurrentCamera or camera
                local vx, vy = cam.ViewportSize.X, cam.ViewportSize.Y
                outline.Position = dim2(
                    0, clamp(start_pos.X.Offset + (input.Position.X - drag_start.X), 0, max(vx - outline.AbsoluteSize.X, 0)),
                    0, clamp(start_pos.Y.Offset + (input.Position.Y - drag_start.Y), 0, max(vy - outline.AbsoluteSize.Y, 0))
                )
            end
        end)

        outline.Visible = true
        return outline
    end

