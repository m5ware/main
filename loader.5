        color = options.color or rgb(255, 255, 255), alpha = has_alpha and options.alpha or 1,
    }
    local h, s, v = cfg.color:ToHSV()
    local a = cfg.alpha
    local dragging = nil

    local swatch = library:create("Frame", {
