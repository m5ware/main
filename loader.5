        })

        -- перетаскиваемый текст (ЛКМ - двигать, ПКМ - сброс), позиция сохраняется в конфиг
        local function make_draggable(lbl, flag)
            lbl.Active = true
            local base = lbl.Position
            local dx, dy = 0, 0
            local dragging, start_mouse, sdx, sdy = false, nil, 0, 0

            local function apply()
                lbl.Position = dim2(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset + dy)
                flags[flag] = {x = dx, y = dy}
            end

            lbl.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    start_mouse = input.Position
                    sdx, sdy = dx, dy
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    dx, dy = 0, 0
                    apply()
                end
            end)
            lbl.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            library:connection(uis.InputChanged, function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local bp, bs = bg.AbsolutePosition, bg.AbsoluteSize
                    local tp, ts = lbl.AbsolutePosition, lbl.AbsoluteSize
                    local ox, oy = tp.X - dx, tp.Y - dy
                    local want_x = sdx + (input.Position.X - start_mouse.X)
                    local want_y = sdy + (input.Position.Y - start_mouse.Y)
                    dx = clamp(want_x, bp.X - ox, bp.X + bs.X - ts.X - ox)
                    dy = clamp(want_y, bp.Y - oy, bp.Y + bs.Y - ts.Y - oy)
                    apply()
                end
            end)
            library:connection(uis.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)

            library.config_flags[flag] = function(v)
                if type(v) == "table" then
                    dx, dy = tonumber(v.x) or 0, tonumber(v.y) or 0
                    apply()
                end
            end
            apply()
        end

        local function esp_label(txt, y_scale, y_off)
            return library:create("TextLabel", {
                Parent = holder, Name = "", FontFace = library.font, TextColor3 = rgb(255, 255, 255),
                Text = txt, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 8,
                AnchorPoint = vec2(0.5, 0), Position = dim2(0.5, 0, y_scale, y_off), Size = dim2(0, 120, 0, 12),
                TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, BackgroundColor3 = rgb(255, 255, 255),
            })
        end
        local name_label = esp_label(string.format("%s (@%s)", lp.DisplayName, lp.Name), 0, -15)
        local dist_label = esp_label("[142m]", 1, 3)
        local weapon_label = esp_label("[ AK-47 ]", 1, 15)
        make_draggable(name_label, "esp_name_pos")
        make_draggable(dist_label, "esp_distance_pos")
        make_draggable(weapon_label, "esp_weapon_pos")

        local hp_back = library:create("Frame", {
            Parent = holder, Name = "", BorderSizePixel = 0, BackgroundColor3 = rgb(0, 0, 0),
            Position = dim2(0, -7, 0, -1), Size = dim2(0, 4, 1, 2), ZIndex = 7,
        })
        local hp_fill = library:create("Frame", {
            Parent = hp_back, Name = "", BorderSizePixel = 0, BackgroundColor3 = rgb(60, 220, 100),
            Position = dim2(0, 1, 0, 1), Size = dim2(1, -2, 1, -2), ZIndex = 8,
        })

        local skeleton = {}
        local function bone(x, y, w, h, vertical)
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0
            f.BackgroundColor3 = rgb(255, 255, 255)
            f.ZIndex = 8
            f.Position = dim2(x, 0, y, 0)
            f.Size = vertical and dim2(0, 1, h, 0) or dim2(w, 0, 0, 1)
            f.Parent = holder
            insert(skeleton, f)
        end
        bone(0.5, 0.18, 0, 0.37, true)
        bone(0.22, 0.22, 0.56, 0, false)
        bone(0.22, 0.22, 0, 0.30, true)
        bone(0.78, 0.22, 0, 0.30, true)
        bone(0.38, 0.55, 0, 0.43, true)
        bone(0.62, 0.55, 0, 0.43, true)
        bone(0.38, 0.55, 0.24, 0, false)

        library:create("TextLabel", {
            Parent = bg, Name = "", FontFace = library.font, TextColor3 = themes.preset.unselected_text,
            Text = "drag model: rotate  |  drag text: move  |  rmb: reset", BackgroundTransparency = 1,
            BorderSizePixel = 0, ZIndex = 10, Position = dim2(0, 0, 1, -14), Size = dim2(1, 0, 0, 12),
            TextSize = 9, TextXAlignment = Enum.TextXAlignment.Center, BackgroundColor3 = rgb(255, 255, 255),
        })

        local function color_of(flag, fallback)
            local f = flags[flag]
            return (type(f) == "table" and typeof(f.Color) == "Color3") and f.Color or fallback
        end

        library:connection(run.RenderStepped, function(dt)
            if not items.sgui.Enabled then return end

            if auto and not rotating then rot = (rot + 40 * dt) % 360 end
            if model and model.Parent then
                pcall(function() model:PivotTo(cfr(0, 0.25, -6.8) * angle(0, rad(rot), 0)) end)
            end

            local box_on = flags["esp_box"] ~= false
            box_black.Visible = box_on
            box_color.Visible = box_on
            box_stroke.Color = color_of("esp_box_color", rgb(255, 255, 255))

            local ff = flags["esp_fill"] == true
            fill.Visible = ff
            if ff then
                fill.BackgroundColor3 = color_of("esp_fill_color", rgb(125, 13, 195))
                local f = flags["esp_fill_color"]
                fill.BackgroundTransparency = (type(f) == "table" and f.Transparency) or 0.75
            end

            name_label.Visible = flags["esp_name"] ~= false
            name_label.TextColor3 = color_of("esp_name_color", rgb(255, 255, 255))

            local hp_on = flags["esp_health"] ~= false
            hp_back.Visible = hp_on
            if hp_on then
                local m = 0.5 + 0.5 * abs(sin(tick() * 2))
                hp_fill.Size = dim2(1, -2, m, -2)
                hp_fill.Position = dim2(0, 1, 1 - m, 1)
                hp_fill.BackgroundColor3 = rgb(255, 50, 50):Lerp(color_of("esp_health_color", rgb(60, 220, 100)), m)
            end

            dist_label.Visible = flags["esp_distance"] ~= false
            dist_label.TextColor3 = color_of("esp_distance_color", rgb(197, 197, 197))

            weapon_label.Visible = flags["esp_weapon"] ~= false
            weapon_label.TextColor3 = color_of("esp_weapon_color", rgb(197, 197, 197))

            local sk_on = flags["esp_skeleton"] == true
            local sk_col = color_of("esp_skeleton_color", rgb(255, 255, 255))
            for _, b in next, skeleton do
                b.Visible = sk_on
                b.BackgroundColor3 = sk_col
            end
        end)

        return panel
    end

    local esp_panel = build_esp_preview()

    -- PLAYERLIST
    local function build_playerlist()
        local mx, my = panel_origin()
        local holder = library:panel({
            name = "Playerlist",
            size = dim2(0, 529, 0, 445),
            position = dim2(0, max(mx - 531, 0), 0, max(my, 0)),
            image = "rbxassetid://107070078834415",
        })
        local items = holder.items
        local column = setmetatable(items, library):column()
        local section = column:section({name = "Playerlist"})
        section:playerlist({})
        section:dropdown({
            name = "Priority", items = {"Enemy", "Priority", "Neutral", "Friendly"}, default = "Neutral",
            flag = "PLAYERLIST_DROPDOWN", callback = function(text) library.prioritize(text) end,
        })
        return holder
    end

    local playerlist_panel = build_playerlist()

    -- при инжекте открыт только main, остальные панели открываются кнопками в доке
    for _, pnl in next, {style_panel, config_panel, esp_panel, playerlist_panel} do
        pnl.items.sgui.Enabled = false
    end

    -- тема и снимок дефолтного конфига применяются ПОСЛЕ того, как твой скрипт создал вкладки и элементы
    task.defer(function()
        library.pickers_ready = true
        library:set_theme("Midnight")
        library.old_config = library:get_config()
    end)
end

return library, themes
