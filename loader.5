-- config
function library:config_list_update()
    if not library.config_holder then return end
    local list = {}
    local ok, files = pcall(listfiles, library.directory .. "/configs")
    if ok and files then
        for _, file in next, files do
            local name = file:match("([^/\\]+)%.cfg$")
            if name then insert(list, name) end
        end
    end
    library.config_holder.refresh_options(list)
end

function library:get_config()
    local Config = {}
    for k, v in next, flags do
        if not (k:find("^config_name") or k == "ui_bind") then
            if type(v) == "table" and typeof(v.Color) == "Color3" then
                Config[k] = {Color = v.Color:ToHex(), Alpha = v.Alpha, Transparency = v.Transparency}
            elseif type(v) == "table" and v.mode ~= nil then
                Config[k] = {active = v.active, mode = v.mode, key = tostring(v.key)}
            elseif v ~= nil then
                Config[k] = v
            end
        end
    end
    return http_service:JSONEncode(Config)
end

function library:load_config(config_json)
    if not config_json then return end
    local ok, config = pcall(function() return http_service:JSONDecode(config_json) end)
    if not ok or type(config) ~= "table" then return end
    for k, v in next, config do
        local fn = library.config_flags[k]
        if fn and not k:find("^config_name") and k ~= "ui_bind" then
            if type(v) == "table" and v.Color then
                pcall(fn, {Color = hex(v.Color), Alpha = v.Alpha, Transparency = v.Transparency})
            else
                pcall(fn, v)
            end
        end
    end
end

