function library:tab(options)
    local cfg = {name = options.name or "tab", enabled = false}

    local tab_holder = library:create("TextButton", {
        Parent = self.tab_holder, FontFace = library.font, TextColor3 = themes.preset.unselected_text,
        BorderColor3 = rgb(0, 0, 0), Text = "", Name = "\0", BorderSizePixel = 0,
        Size = dim2(0, 0, 1, -2), ZIndex = 5, TextSize = 12,
        BackgroundColor3 = themes.preset.outline, AutoButtonColor = false, BackgroundTransparency = 1,
    })

    local text = library:create("TextLabel", {
        Parent = tab_holder, FontFace = library.font, TextColor3 = themes.preset.unselected_text,
        BorderColor3 = rgb(0, 0, 0), Text = cfg.name, Name = "\0", BackgroundTransparency = 1,
        Size = dim2(1, 0, 1, -2), BorderSizePixel = 0, TextSize = 12, ZIndex = 5,
        TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center,
        BackgroundColor3 = rgb(255, 255, 255),
    }, "text")
    local tab_gradient = library:shimmer(text)

    local accent_line = library:create("Frame", {
        Parent = tab_holder, Name = "accent_line", Position = dim2(0, 0, 1, -2),
        BorderColor3 = rgb(0, 0, 0), Size = dim2(1, 0, 0, 2),
        BorderSizePixel = 0, ZIndex = 6, Visible = true,
        BackgroundColor3 = themes.preset.purple,
    })

    local accent_gradient = library:create("UIGradient", {
        Parent = accent_line,
        Color = rgbseq{
            rgbkey(0, rgb(120, 60, 200)),
            rgbkey(0.5, rgb(200, 130, 255)),
            rgbkey(1, rgb(120, 60, 200))
        },
    })
    insert(library.tab_gradients, accent_gradient)
    library:apply_theme(accent_line, "purple", "BackgroundColor3")

    task.spawn(function()
        local t = 0
        while accent_line.Parent do
            t = t + task.wait()
            accent_gradient.Offset = Vector2.new(math.sin(t * 2) * 0.5, 0)
        end
    end)

    library:create("Frame", {
        Parent = accent_line, Name = "", BackgroundTransparency = 0.5,
        Position = dim2(0, 0, 0, 1), BorderColor3 = rgb(0, 0, 0),
        Size = dim2(1, 0, 0, 1), BorderSizePixel = 0, BackgroundColor3 = rgb(0, 0, 0),
    })

    local section_holder = library:create("Frame", {
        Parent = library.section_holder, BackgroundTransparency = 1, Name = "\0",
        BorderColor3 = rgb(0, 0, 0), Size = dim2(1, 0, 1, 0), BorderSizePixel = 0,
        Visible = false, BackgroundColor3 = rgb(255, 255, 255),
    })
    cfg["holder"] = section_holder
    library:create("UIListLayout", {
        Parent = section_holder, FillDirection = Enum.FillDirection.Horizontal,
        HorizontalFlex = Enum.UIFlexAlignment.Fill, Padding = dim(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
    })

    function cfg.open_tab()
        if library.current_tab and library.current_tab[1] ~= tab_holder then
            local prev_button = library.current_tab[1]
            local prev_text = prev_button:FindFirstChildOfClass("TextLabel")
            if prev_text then
                prev_text.TextColor3 = themes.preset.unselected_text
                local pg = prev_text:FindFirstChildOfClass("UIGradient")
                if pg then pg.Enabled = false end
            end
            library.current_tab[2].Visible = false
            library.current_tab = nil
        end

        library.current_tab = {tab_holder, section_holder}
        text.TextColor3 = themes.preset.pink
        tab_gradient.Enabled = true
        section_holder.Visible = true
        if library.current_element_open and library.current_element_open ~= cfg then
            library.current_element_open.set_visible(false)
            library.current_element_open.open = false
            library.current_element_open = nil
        end
    end

    tab_holder.MouseButton1Click:Connect(cfg.open_tab)

    -- первая созданная вкладка открывается сама
    if not library.current_tab then cfg.open_tab() end

    return setmetatable(cfg, library)
end

