-- цвет "призрачной" рамки при перетаскивании окон (следует теме)
function library:update_drag(col)
    if library.drag_gradient then
        library.drag_gradient.Color = rgbseq{
            rgbkey(0, col:Lerp(rgb(0, 0, 0), 0.6)),
            rgbkey(1, col:Lerp(rgb(0, 0, 0), 0.82)),
        }
    end
end

-- перекраска тёмного фона меню
function library:tint_background(high, low, inline_col)
    local function close(c1, c2)
        return abs(c1.R - c2.R) < 0.004 and abs(c1.G - c2.G) < 0.004 and abs(c1.B - c2.B) < 0.004
    end
    local old_high, old_low = themes.preset.high_contrast, themes.preset.low_contrast
    for _, g in next, themes.utility.contrast.Color do
        local kps = g.Color.Keypoints
        if #kps == 2 then
            local new, changed = {}, false
            for i, kp in ipairs(kps) do
                local val = kp.Value
                if close(val, old_high) then val = high; changed = true
                elseif close(val, old_low) then val = low; changed = true end
                new[i] = rgbkey(kp.Time, val)
            end
            if changed then g.Color = rgbseq(new) end
        end
    end
    library:update_theme("inline", inline_col)
    themes.preset.high_contrast = high
    themes.preset.low_contrast = low
end

-- цвет меню одним цветом (для пикера)
function library:set_menu_color(col)
    library:update_theme("pink", col)
    library:update_theme("purple", col)
    local dark, light = col:Lerp(rgb(0, 0, 0), 0.35), col:Lerp(rgb(255, 255, 255), 0.3)
    for _, g in next, library.tab_gradients do
        g.Color = rgbseq{rgbkey(0, dark), rgbkey(0.5, light), rgbkey(1, dark)}
    end
    for _, l in next, library.logo_labels do l.TextColor3 = light end
    library:update_drag(col)
end

function library:set_theme(name)
    local t = library.theme_presets[name]
    if not t then return end
    library:update_theme("pink", t.pink)
    library:update_theme("accent", t.accent)
    library:update_theme("purple", t.purple)
    for _, g in next, library.tab_gradients do
        g.Color = rgbseq{rgbkey(0, t.grad_dark), rgbkey(0.5, t.grad_light), rgbkey(1, t.grad_dark)}
    end
    library:tint_background(t.bg_high, t.bg_low, t.inline)
    for _, l in next, library.logo_labels do l.TextColor3 = t.logo end
    library:update_drag(t.pink)

    -- обновляем пикеры в Style под выбранную тему (без вызова их callback)
    if library.pickers_ready then
        library.syncing = true
        local function sy(flag, col)
            local f = library.config_flags[flag]
            if f and col then pcall(f, col) end
        end
        sy("menu_color", t.pink); sy("accent_color", t.accent); sy("inline_color", t.inline)
        sy("outline_color", themes.preset.outline); sy("text_color", themes.preset.text)
        sy("bg_high", t.bg_high); sy("bg_low", t.bg_low)
        library.syncing = false
    end
end

-- переливание текста выбранной вкладки: цвет темы -> светлый оттенок темы
function library:shimmer(label)
    local g = Instance.new("UIGradient")
    g.Color = rgbseq{rgbkey(0, rgb(255, 255, 255)), rgbkey(1, rgb(255, 255, 255))}
    g.Enabled = false
    g.Parent = label
    task.spawn(function()
        local t = 0
        while label.Parent do
            t = t + task.wait()
            if g.Enabled then
                local a = (math.sin(t * 2.5) + 1) / 2
                label.TextColor3 = themes.preset.pink:Lerp(rgb(255, 255, 255), a * 0.45)
            end
        end
    end)
    return g
end

function library:create(instance, options)
    local ins = Instance.new(instance)
    for prop, value in next, options do ins[prop] = value end
    if instance == "TextLabel" or instance == "TextButton" or instance == "TextBox" then
        library:apply_theme(ins, "text", "TextColor3")
        library:apply_stroke(ins)
    elseif instance == "ScreenGui" then
        insert(library.guis, ins)
    end
    return ins
end
