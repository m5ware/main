    })
    library:create("UIGradient", {
        Parent = swatch_color, Rotation = 90,
        Color = rgbseq{rgbkey(0, rgb(255, 255, 255)), rgbkey(1, rgb(190, 190, 190))},
    })

    local width, height = 150, has_alpha and 164 or 148
    local popup = library:create("Frame", {
        Parent = sgui, Name = "", Visible = false, BorderSizePixel = 0, ZIndex = 1, Active = true,
        Size = dim2(0, width, 0, height), BackgroundColor3 = themes.preset.outline,
    })
    library:apply_theme(popup, "outline", "BackgroundColor3")
    local popup_inline = library:create("Frame", {
        Parent = popup, Name = "", Position = dim2(0, 1, 0, 1), Size = dim2(1, -2, 1, -2),
        BorderSizePixel = 0, BackgroundColor3 = themes.preset.inline,
    })
    library:apply_theme(popup_inline, "inline", "BackgroundColor3")
    local body = library:create("Frame", {
        Parent = popup_inline, Name = "", Position = dim2(0, 1, 0, 1), Size = dim2(1, -2, 1, -2),
        BorderSizePixel = 0, BackgroundColor3 = rgb(255, 255, 255),
    })
    local body_gradient = library:create("UIGradient", {
        Parent = body, Rotation = 90,
        Color = rgbseq{rgbkey(0, themes.preset.high_contrast), rgbkey(1, themes.preset.low_contrast)},
    })
    library:apply_theme(body_gradient, "contrast", "Color")
    library:create("TextLabel", {
        Parent = body, Name = "", FontFace = library.font, TextColor3 = themes.preset.text,
        Text = cfg.name, BackgroundTransparency = 1, Position = dim2(0, 6, 0, 3),
        Size = dim2(1, -12, 0, 12), BorderSizePixel = 0, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = rgb(255, 255, 255),
    })

    local sv_box = library:create("Frame", {
        Parent = body, Name = "", Position = dim2(0, 8, 0, 20), Size = dim2(1, -16, 0, 100),
        BorderSizePixel = 0, BackgroundColor3 = hsv(h, 1, 1),
    })
    library:create("UIStroke", {Parent = sv_box, Color = rgb(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
    local sv_white = library:create("Frame", {
        Parent = sv_box, Name = "", Size = dim2(1, 0, 1, 0), BorderSizePixel = 0,
        BackgroundColor3 = rgb(255, 255, 255),
    })
    library:create("UIGradient", {Parent = sv_white, Transparency = numseq{numkey(0, 0), numkey(1, 1)}})
    local sv_black = library:create("Frame", {
        Parent = sv_box, Name = "", Size = dim2(1, 0, 1, 0), BorderSizePixel = 0,
        BackgroundColor3 = rgb(0, 0, 0),
    })
    library:create("UIGradient", {Parent = sv_black, Rotation = 90, Transparency = numseq{numkey(0, 1), numkey(1, 0)}})
    local sv_cursor = library:create("Frame", {
        Parent = sv_box, Name = "", Size = dim2(0, 4, 0, 4), BorderSizePixel = 0,
        BackgroundColor3 = rgb(255, 255, 255), ZIndex = 2,
    })
    library:create("UIStroke", {Parent = sv_cursor, Color = rgb(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border})

    local hue_bar = library:create("Frame", {
        Parent = body, Name = "", Position = dim2(0, 8, 0, 126), Size = dim2(1, -16, 0, 10),
        BorderSizePixel = 0, BackgroundColor3 = rgb(255, 255, 255),
    })
    library:create("UIStroke", {Parent = hue_bar, Color = rgb(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
    local rainbow = {}
    for i = 0, 6 do insert(rainbow, rgbkey(i / 6, hsv(i / 6, 1, 1))) end
    library:create("UIGradient", {Parent = hue_bar, Color = rgbseq(rainbow)})
    local hue_cursor = library:create("Frame", {
        Parent = hue_bar, Name = "", Size = dim2(0, 2, 1, 4), BorderSizePixel = 0,
        BackgroundColor3 = rgb(255, 255, 255), ZIndex = 2,
    })
    library:create("UIStroke", {Parent = hue_cursor, Color = rgb(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border})

    local alpha_bar, alpha_gradient, alpha_cursor
    if has_alpha then
        alpha_bar = library:create("Frame", {
            Parent = body, Name = "", Position = dim2(0, 8, 0, 142), Size = dim2(1, -16, 0, 10),
            BorderSizePixel = 0, BackgroundColor3 = rgb(255, 255, 255),
        })
        library:create("UIStroke", {Parent = alpha_bar, Color = rgb(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
        alpha_gradient = library:create("UIGradient", {
            Parent = alpha_bar, Color = rgbseq{rgbkey(0, rgb(20, 20, 20)), rgbkey(1, cfg.color)},
        })
        alpha_cursor = library:create("Frame", {
            Parent = alpha_bar, Name = "", Size = dim2(0, 2, 1, 4), BorderSizePixel = 0,
            BackgroundColor3 = rgb(255, 255, 255), ZIndex = 2,
        })
        library:create("UIStroke", {Parent = alpha_cursor, Color = rgb(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
    end

    local function update()
        local col = hsv(h, s, v)
        cfg.color = col
        cfg.alpha = a
        swatch_color.BackgroundColor3 = col
        sv_box.BackgroundColor3 = hsv(h, 1, 1)
        sv_cursor.Position = dim2(s, -2, 1 - v, -2)
        hue_cursor.Position = dim2(h, -1, 0, -2)
        if has_alpha then
            alpha_gradient.Color = rgbseq{rgbkey(0, rgb(20, 20, 20)), rgbkey(1, col)}
            alpha_cursor.Position = dim2(a, -1, 0, -2)
        end
        flags[cfg.flag] = {Color = col, Alpha = a, Transparency = 1 - a}
        cfg.callback(col, a)
    end

    local function handle(kind, input)
        if kind == "sv" then
            local pos, size = sv_box.AbsolutePosition, sv_box.AbsoluteSize
            s = clamp((input.Position.X - pos.X) / size.X, 0, 1)
            v = 1 - clamp((input.Position.Y - pos.Y) / size.Y, 0, 1)
        elseif kind == "hue" then
            local pos, size = hue_bar.AbsolutePosition, hue_bar.AbsoluteSize
            h = clamp((input.Position.X - pos.X) / size.X, 0, 1)
        elseif kind == "alpha" and has_alpha then
            local pos, size = alpha_bar.AbsolutePosition, alpha_bar.AbsoluteSize
            a = clamp((input.Position.X - pos.X) / size.X, 0, 1)
        end
        update()
    end

    local function bind(kind, gui)
        gui.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = kind
                handle(kind, input)
            end
        end)
    end
    bind("sv", sv_box); bind("sv", sv_white); bind("sv", sv_black)
    bind("hue", hue_bar)
    if has_alpha then bind("alpha", alpha_bar) end

    library:connection(uis.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            handle(dragging, input)
        end
    end)
    library:connection(uis.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = nil end
    end)

    function cfg.set_visible(bool)
        popup.Visible = bool
        local x = swatch.AbsolutePosition.X - width + 20
        local y = min(swatch.AbsolutePosition.Y + 14, camera.ViewportSize.Y - height - 4)
        popup.Position = dim2(0, max(x, 4), 0, max(y, 4))
        if bool then
            if library.current_element_open and library.current_element_open ~= cfg then
                library.current_element_open.set_visible(false)
                library.current_element_open.open = false
            end
            library.current_element_open = cfg
        end
    end

    function cfg.set(value)
        if typeof(value) == "Color3" then
            h, s, v = value:ToHSV()
        elseif type(value) == "table" then
            if typeof(value.Color) == "Color3" then h, s, v = value.Color:ToHSV() end
            if value.Alpha then a = value.Alpha elseif value.Transparency then a = 1 - value.Transparency end
        end
        update()
    end

    swatch.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            cfg.open = not cfg.open
            cfg.set_visible(cfg.open)
        end
    end)

    cfg.set(cfg.color)
    library.config_flags[cfg.flag] = cfg.set
    return self
end

